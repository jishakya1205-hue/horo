{
  "version": 2,
  "functions": {
  "api/*.js": {
    "memory": 128,
    "maxDuration": 15
  }
},
    "api/kundli-pdf.js": {
      "memory": 128,
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
